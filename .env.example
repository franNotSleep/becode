# becode runs on your Claude subscription, not an API key.
#
#   claude setup-token          # mints a long-lived token
#   cp .env.example .env.local  # then paste it below
#
# It covers both the agent and the policy judge.
CLAUDE_CODE_OAUTH_TOKEN=

# An API key works too, if you would rather be billed per token.
# ANTHROPIC_API_KEY=

# Optional. Tool-turn budget for one task.
# BECODE_MAX_TURNS=120

# Where a booted port is reachable from a browser. `{port}` is the only substitution.
# Unset is right on a laptop, where the browser and the dev server share a loopback. On a server
# they do not, and without this the workshop window iframes `http://localhost:<port>` — which means
# the *viewer's* machine, so the frame comes up empty. See `deploy/`.
# BECODE_PUBLIC_URL=https://p{port}.example.com

# Optional. Files a Linear issue for every pull request becode opens, and puts the issue
# identifier in the branch name so Linear's GitHub integration links the two.
# Personal API key from linear.app/settings/api. Without it, PRs still open — untracked.
# LINEAR_API_KEY=

# Attachment storage. `docker compose up -d` starts it; the defaults below match the compose file,
# so you only need these if you changed them there. The secret is stripped from every child
# process becode spawns, like the tokens above.
# MINIO_ENDPOINT=127.0.0.1
# MINIO_PORT=9040
# MINIO_ACCESS_KEY=becode
# MINIO_SECRET_KEY=becode-dev-secret
# MINIO_BUCKET=becode-attachments

# --- Sign-in -------------------------------------------------------------------------------
# Unset, becode runs open: no login, every route reachable. That is fine on a laptop and is what
# it did before this existed. Set a secret and it is enforced everywhere except /login and
# /api/auth — see `proxy.ts`.
#
#   openssl rand -base64 32
# BETTER_AUTH_SECRET=

# The origin the browser uses. Behind a reverse proxy this cannot be inferred from the socket.
# BETTER_AUTH_URL=https://becode.example.com
# BETTER_AUTH_TRUSTED_ORIGINS=https://becode.example.com

# Who may sign in. Any address at this domain; everything else is refused before a code is sent.
# BECODE_EMAIL_DOMAIN=tix.do

# Set this to the parent domain to have one session cover the p<port> preview hosts too, which is
# what lets the reverse proxy gate them through /api/auth/gate.
# BECODE_COOKIE_DOMAIN=.becode.example.com

# Delivering the code. Without both, the code is written to the log with a warning instead — for
# first boot only, never for real use.
# SENDGRID_API_KEY=
# SENDGRID_FROM=becode@example.com
