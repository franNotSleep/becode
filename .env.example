# becode runs on your Claude subscription, not an API key.
#
#   claude setup-token          # mints a long-lived token
#   cp .env.example .env.local  # then paste it below
#
# It covers both the agent and the policy judge.
CLAUDE_CODE_OAUTH_TOKEN=

# An API key works too, if you would rather be billed per token.
# ANTHROPIC_API_KEY=

# Optional. Tool-turn budget for one task.
# BECODE_MAX_TURNS=120

# Optional. Files a Linear issue for every pull request becode opens, and puts the issue
# identifier in the branch name so Linear's GitHub integration links the two.
# Personal API key from linear.app/settings/api. Without it, PRs still open — untracked.
# LINEAR_API_KEY=
