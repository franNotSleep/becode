# becode needs one model credential. Copy this to .env.local and fill it in.
#
#   cp .env.example .env.local
#
# Get a key at https://vercel.com/ai-gateway — it routes both the agent model
# (anthropic/claude-opus-5) and the policy judge (anthropic/claude-haiku-4.5).
AI_GATEWAY_API_KEY=

# Alternative to the above when running against a linked Vercel project:
# VERCEL_OIDC_TOKEN=
