# /home/becode/stack/.env  —  chmod 0600, chown 10001:10001
#
# The name matters. Compose reads a file called `.env` beside the compose file for `${...}`
# interpolation, and the services also load it as their `env_file`. Call it anything else and the
# MinIO credentials below are silently not seen, with an error naming a variable you have set.
#
# Watchtower recreates the container from the *running* container's resolved environment, not from
# this file. So changing a value here needs `docker compose up -d becode` to take effect; a nightly
# Watchtower update alone will keep serving the old one.

# becode runs on a Claude subscription token: `claude setup-token` on any machine, paste here.
# It is long-lived but not eternal — when it expires, every turn starts failing at once.
CLAUDE_CODE_OAUTH_TOKEN=

# Where a booted port is reachable from a browser. `{port}` is the only substitution.
# Without this the workshop window iframes http://localhost:<port>, which on a server means the
# *viewer's* machine.
BECODE_PUBLIC_URL=https://p{port}.becode.v3.tix.do

# Lets `gh pr create` and `git push` work without an SSH key. Scope it to the target repo:
# Contents read/write + Pull requests read/write. `childEnv` keeps it out of spawned dev servers.
GH_TOKEN=

# Optional. Files a Linear issue per PR and puts its identifier in the branch name. Without it
# PRs still open, untracked.
LINEAR_API_KEY=

# Attachment storage. Both becode and the minio container read these.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9040
MINIO_ACCESS_KEY=becode
MINIO_SECRET_KEY=
MINIO_BUCKET=becode-attachments

# --- Sign-in -------------------------------------------------------------------------------
# Leave BETTER_AUTH_SECRET unset and becode runs open — no login, every route reachable by anyone
# who knows the hostname, and `POST /api/agent` is a shell. Set it.
#
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# The origin the browser actually used. Behind Caddy this cannot be inferred from the socket, and
# without the trusted origin every state-changing auth call answers 403 — verified, not guessed.
BETTER_AUTH_URL=https://becode.v3.tix.do
BETTER_AUTH_TRUSTED_ORIGINS=https://becode.v3.tix.do

# Who may sign in. Any address at this domain; everything else is refused before a code is sent.
BECODE_EMAIL_DOMAIN=tix.do

# The parent domain, so one session also covers the p<port> preview hosts. This is what makes
# Caddy's `forward_auth` to /api/auth/gate work — drop it and the previews cannot be gated.
BECODE_COOKIE_DOMAIN=.becode.v3.tix.do

# Delivering the code. The tix backend already uses SendGrid, so reuse that key and a verified
# sender. Without both, becode writes the code to its own log with a warning — first boot only.
SENDGRID_API_KEY=
SENDGRID_FROM=becode@tix.do
